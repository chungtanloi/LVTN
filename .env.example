# Sao chép thành .env (đã nằm trong .gitignore) và điền giá trị. KHÔNG commit .env.
# Trên cloud: thêm các biến này vào môi trường của phiên (Edit environment), không dán khoá vào chat.

# --- Baseline Tuần 21 (CPA2_KhaoSat/w21_baseline) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# ID model theo tài liệu hiện hành của nhà cung cấp (tên thương mại trong CLAUDE.md cần đối chiếu ID API)
BASELINE_OPENAI_MODEL=
BASELINE_GEMINI_MODEL=

# Giá token hiện hành (USD / 1 triệu token). Bắt buộc để chạy thật: hệ thống không đoán giá.
BASELINE_OPENAI_PRICE_IN=
BASELINE_OPENAI_PRICE_OUT=
BASELINE_GEMINI_PRICE_IN=
BASELINE_GEMINI_PRICE_OUT=

# Trần chi phí cho MỘT lần chạy (USD). Mặc định 5. Phải là số > 0.
BASELINE_MAX_USD=5

# Nhiệt độ lấy mẫu (mặc định 0). Đặt 'none' để bỏ tham số — cần với model từ chối nhiệt độ khác mặc định.
BASELINE_TEMPERATURE=0
# Trần token ra mỗi lần gọi (bỏ trống = không đặt trần; model suy luận tính cả token nghĩ).
BASELINE_MAX_OUT=

# (Tuỳ chọn, chỉ để kiểm thử) đổi địa chỉ gốc API sang máy chủ giả cục bộ. Khoá sẽ gửi tới địa chỉ này — đừng đặt địa chỉ lạ.
# BASELINE_OPENAI_BASE_URL=
# BASELINE_GEMINI_BASE_URL=
