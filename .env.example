# Sao chép thành .env (đã nằm trong .gitignore) và điền giá trị. KHÔNG commit .env.
# Trên cloud: thêm các biến này vào môi trường của phiên (Edit environment), không dán khoá vào chat.

# --- Baseline Tuần 21 (CPA2_KhaoSat/w21_baseline) ---
# Cách 1 — API gốc: khoá riêng từng nhà cung cấp.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cách 2 — qua OpenRouter (một khoá cho cả hai họ model): đặt VIA=openrouter cho họ muốn đi qua OpenRouter; khi đó
# khoá *_API_KEY gốc của họ đó không dùng. ID model và giá lấy trên trang model của OpenRouter (vd. openai/…, google/…).
# Phí nạp credit của OpenRouter KHÔNG nằm trong giá token → chi phí thực cao hơn số trần tính được một chút.
# Báo cáo phải ghi "qua OpenRouter" (kết quả có meta.qua và phuc_vu từng ca).
OPENROUTER_API_KEY=
BASELINE_OPENAI_VIA=
BASELINE_GEMINI_VIA=

# ID model theo tài liệu hiện hành của nhà cung cấp (tên thương mại trong CLAUDE.md cần đối chiếu ID API)
BASELINE_OPENAI_MODEL=
BASELINE_GEMINI_MODEL=

# Giá token hiện hành (USD / 1 triệu token). Bắt buộc để chạy thật: hệ thống không đoán giá.
BASELINE_OPENAI_PRICE_IN=
BASELINE_OPENAI_PRICE_OUT=
BASELINE_GEMINI_PRICE_IN=
BASELINE_GEMINI_PRICE_OUT=

# Trần chi phí cho MỘT lần chạy (USD). Mặc định 5. Phải là số > 0.
BASELINE_MAX_USD=5

# Nhiệt độ lấy mẫu. Bỏ trống = theo bản đóng băng llm.THAM_SO (từ 19/11/2026: none = không gửi temperature, vì model
# OpenAI suy luận không nhận). Đặt giá trị khác bản đóng băng thì run_baseline chỉ chạy với --hau-to (không chính thức).
BASELINE_TEMPERATURE=
# Trần token ra mỗi lần gọi (bỏ trống = không đặt trần; model suy luận tính cả token nghĩ).
BASELINE_MAX_OUT=

# (Tuỳ chọn, chỉ để kiểm thử) đổi địa chỉ gốc API sang máy chủ giả cục bộ. Khoá sẽ gửi tới địa chỉ này — đừng đặt địa chỉ lạ.
# BASELINE_OPENAI_BASE_URL=
# BASELINE_GEMINI_BASE_URL=
# Khi VIA=openrouter chỉ biến dưới đây có hiệu lực (mặc định https://openrouter.ai/api/v1; chỉ nhận https hoặc máy cục bộ).
# BASELINE_OPENROUTER_BASE_URL=
