# Local development only. Never enable a demo bypass on a public deployment.
CPA2_DEMO_MODE=true
CPA2_API_URL=http://127.0.0.1:8000
CPA2_SERVICE_KEY=

# Configure all of these for authenticated cloud operation.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Convex dashboard additionally needs CLERK_JWT_ISSUER_DOMAIN,
# CPA2_API_URL and CPA2_SERVICE_KEY. See ../README.md.
